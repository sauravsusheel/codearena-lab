FROM node:22-bookworm AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund --omit=optional
COPY . .
ARG VITE_CODEARENA_API_URL=/api-proxy
ARG VITE_CODEARENA_REQUIRE_AUTH=1
ENV VITE_CODEARENA_API_URL=${VITE_CODEARENA_API_URL}
ENV VITE_CODEARENA_REQUIRE_AUTH=${VITE_CODEARENA_REQUIRE_AUTH}
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.codearena.conf.template /etc/nginx/templates/default.conf.template
ENV CODEARENA_API_PROXY_TARGET=http://codearena-api:8787
ENV NGINX_ENVSUBST_TEMPLATE_VARS=\$CODEARENA_API_PROXY_TARGET
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
