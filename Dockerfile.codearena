FROM node:22-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client ca-certificates docker.io awscli && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci --omit=optional
COPY . .
ENV CODEARENA_HOST=0.0.0.0
ENV CODEARENA_PORT=8787
EXPOSE 8787
CMD ["node","server/index.mjs"]
