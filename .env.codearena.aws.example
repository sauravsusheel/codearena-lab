# Copy to your deployment environment; do not commit real secrets.
CODEARENA_PORT=8787
CODEARENA_PRODUCTION=1
CODEARENA_EXTERNAL_WORKER=1
CODEARENA_DOCKER=1
CODEARENA_REDIS_REQUIRED=1
CODEARENA_REDIS_QUEUE_KEY=codearena:submissions
POSTGRES_PASSWORD=replace-with-a-random-secret
REDIS_PASSWORD=replace-with-a-different-random-secret
CODEARENA_JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
CODEARENA_WORKER_SECRET=REPLACE_WITH_24_PLUS_RANDOM_CHARACTERS
CODEARENA_CORS_ORIGIN=https://your-codearena-domain.example
# Optional first-run administrator (remove/rotate after bootstrap).
# CODEARENA_BOOTSTRAP_ADMIN_USN=CODEARENA-ADMIN
# CODEARENA_BOOTSTRAP_ADMIN_NAME=CodeArena Administrator
# CODEARENA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-plus-char-secret
# For UniSphere SSO, configure a separate signing secret shared only with the portal.
# CODEARENA_SSO_JWT_SECRET=replace-with-a-random-32-plus-char-secret
CODEARENA_RATE_LIMIT=120
CODEARENA_MIN_LEARNING_HOURS=5
# Optional: run Docker containers under gVisor.
# CODEARENA_SANDBOX_RUNTIME=runsc
# Frontend:
# VITE_CODEARENA_API_URL=https://your-codearena-domain.example
# VITE_CODEARENA_REQUIRE_AUTH=1

# AWS production profile (Terraform creates the actual values/secrets).
AWS_REGION=ap-south-1
CODEARENA_BACKUP_S3_URI=s3://codearena-production-backups
CODEARENA_API_PROXY_TARGET=http://127.0.0.1:8787
