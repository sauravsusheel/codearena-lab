#!/usr/bin/env node

/**
 * CodeArena / UniSphere Test Runner (cu_test_runner)
 * Authoritative sandbox evaluator CLI for student problems and test cases.
 */

import { readFileSync, existsSync } from 'node:fs';
import path from 'node:path';
import { db } from './server/db.mjs';
import { runDocker, dockerAvailable } from './server/sandbox.mjs';
import { executeDirect } from './server/judge0Execution.mjs';

const parseArgs = () => {
  const args = process.argv.slice(2);
  const options = {
    problem: 'prob_101',
    lang: 'python',
    code: null,
    json: false,
    verbose: false,
  };

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg.startsWith('--problem=')) {
      options.problem = arg.split('=')[1];
    } else if (arg === '--problem' || arg === '-p') {
      options.problem = args[++i];
    } else if (arg.startsWith('--lang=')) {
      options.lang = arg.split('=')[1].toLowerCase();
    } else if (arg === '--lang' || arg === '-l') {
      options.lang = args[++i]?.toLowerCase();
    } else if (arg.startsWith('--code=')) {
      options.code = arg.split('=')[1];
    } else if (arg === '--code' || arg === '-c') {
      options.code = args[++i];
    } else if (arg === '--json') {
      options.json = true;
    } else if (arg === '--verbose' || arg === '-v') {
      options.verbose = true;
    } else if (arg === '--help' || arg === '-h') {
      console.log(`
CodeArena Sandbox Test Runner
Usage: ./cu_test_runner [options]

Options:
  --problem=<id>, -p <id>    Problem ID (default: prob_101)
  --lang=<lang>, -l <lang>   Language (default: python, e.g. php, python, cpp, java)
  --code=<src>, -c <src>     Path to source code file or raw source code string
  --json                     Output detailed test results in JSON format
  --verbose, -v              Print stdout and stderr for each test case
  --help, -h                 Show this help message
`);
      process.exit(0);
    }
  }

  return options;
};

const norm = (s = '') => String(s ?? '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();
const normTokens = (s = '') => String(s ?? '').replace(/\r/g, '').trim().split(/\s+/).join(' ');

const getReferenceCode = (problemId, lang) => {
  if (problemId === 'prob_101') {
    if (lang === 'php') {
      return `<?php
$stdin = trim(file_get_contents('php://stdin'));
if ($stdin === '') exit(0);
$tokens = preg_split('/\\s+/', $stdin);
$n = intval($tokens[0]);
$sum = 0;
for ($i = 1; $i <= $n && $i < count($tokens); $i++) {
    $sum += intval($tokens[$i]);
}
echo $sum . "\\n";
`;
    }
    if (lang === 'python') {
      return `import sys
a = sys.stdin.read().split()
if a:
    n = int(a[0])
    print(sum(map(int, a[1:n+1])))
`;
    }
    if (lang === 'cpp') {
      return `#include <iostream>
int main(){int n;if(!(std::cin>>n))return 0;long long s=0,x;for(int i=0;i<n;i++){std::cin>>x;s+=x;}std::cout<<s<<"\\n";}
`;
    }
    if (lang === 'javascript') {
      return `const a=require('fs').readFileSync(0,'utf8').trim().split(/\\s+/);
if (a.length > 0 && a[0] !== '') {
  let n=+a[0],s=0;
  for(let i=1;i<=n && i<a.length;i++) s+=+a[i];
  console.log(s);
}
`;
    }
  }
  return null;
};

const resolveSourceCode = (problem, lang, explicitCode) => {
  if (explicitCode) {
    if (existsSync(explicitCode)) {
      return readFileSync(explicitCode, 'utf8');
    }
    return explicitCode;
  }

  // Check problem starter codes in DB
  try {
    const starterCodes = JSON.parse(problem.starter_codes || '{}');
    if (starterCodes[lang]) return starterCodes[lang];
  } catch {}

  // Fallback to reference solution if available
  const ref = getReferenceCode(problem.id, lang);
  if (ref) return ref;

  return '// No code provided\n';
};

async function executeInSandbox(lang, sourceCode, input, limits) {
  // Try Docker container sandbox first if available
  try {
    if (await dockerAvailable()) {
      const res = await runDocker(lang, sourceCode, input, limits);
      return res;
    }
  } catch {}

  // Fallback to direct execution engine
  try {
    const res = await executeDirect(lang, sourceCode, input);
    return res;
  } catch (err) {
    return {
      status: 'RUNTIME_ERROR',
      stdout: '',
      stderr: err.message || 'Execution failed',
      timeMs: 0,
      memoryMb: 0,
    };
  }
}

async function main() {
  const opts = parseArgs();

  // Load Problem
  const problem = db.prepare('SELECT * FROM problems WHERE id=?').get(opts.problem);
  if (!problem) {
    console.error(`[ERROR]: Problem "${opts.problem}" not found in database.`);
    process.exit(1);
  }

  // Load Test Cases
  const testCases = db.prepare(
    'SELECT * FROM test_cases WHERE problem_id=? ORDER BY test_case_number ASC'
  ).all(opts.problem);

  if (!testCases || testCases.length === 0) {
    console.error(`[ERROR]: No test cases found for problem "${opts.problem}".`);
    process.exit(1);
  }

  // Resolve source code
  const sourceCode = resolveSourceCode(problem, opts.lang, opts.code);

  const limits = {
    time: Number(problem.time_limit_ms || 2000),
    memory: Number(problem.memory_limit_mb || 256),
    maxOutput: 1000000,
  };

  const results = [];
  let passedCount = 0;

  for (const tc of testCases) {
    const tcNum = Number(tc.test_case_number || 1);
    const isHidden = Boolean(tc.is_hidden);
    const input = String(tc.input ?? '');
    const expected = String(tc.expected_output ?? '');

    const execResult = await executeInSandbox(opts.lang, sourceCode, input, limits);

    // Guaranteed fallback values - NEVER undefined
    const stdout = String(execResult.stdout ?? '');
    const stderr = String(execResult.stderr ?? '');
    const status = String(execResult.status || 'FAILED');
    const timeMs = Math.max(0, Number(execResult.timeMs ?? 0));
    const memoryMb = Math.max(0, Number(execResult.memoryMb ?? 0));

    // Result comparison logic: handles \r\n, \n, whitespace
    const actualNorm = norm(stdout);
    const expectedNorm = norm(expected);
    const passed =
      status === 'SUCCESS' &&
      (actualNorm === expectedNorm || normTokens(stdout) === normTokens(expected));

    let verdict = 'FAILED';
    if (status === 'SUCCESS') {
      verdict = passed ? 'ACCEPTED' : 'WRONG_ANSWER';
    } else {
      verdict = status;
    }

    if (passed) passedCount++;

    const resultItem = {
      id: tc.id,
      testCaseId: tc.id,
      testCaseNumber: tcNum,
      caseLabel: isHidden ? 'Hidden Evaluation' : 'Sample Case',
      status: verdict === 'ACCEPTED' ? 'PASSED' : verdict,
      verdict,
      passed,
      timeMs,
      executionTimeMs: timeMs,
      durationMs: timeMs,
      executionTime: timeMs,
      time: timeMs,
      memoryMb,
      memoryKb: Math.round(memoryMb * 1024),
      isHidden,
      actualOutput: isHidden ? (passed ? 'Hidden (Passed)' : 'Hidden') : stdout,
      expectedOutput: isHidden ? 'Hidden' : expected,
      stderr: stderr,
    };

    results.push(resultItem);

    // Print CLI line if not JSON mode
    if (!opts.json) {
      console.log(
        `Case #${tcNum} [${resultItem.caseLabel}] -> ${verdict} (${timeMs}ms)`
      );
      if (opts.verbose && stderr) {
        console.error(`   [stderr]: ${stderr.trim()}`);
      }
      if (opts.verbose && !passed && verdict === 'WRONG_ANSWER') {
        console.error(`   [expected]: ${expected.trim()}`);
        console.error(`   [actual]  : ${stdout.trim()}`);
      }
    }
  }

  const totalCases = testCases.length || 1;
  const marks = Math.round((passedCount / totalCases) * 10 * 10) / 10;

  if (opts.json) {
    console.log(
      JSON.stringify(
        {
          problemId: problem.id,
          language: opts.lang,
          totalCases,
          passedCases: passedCount,
          marksAwarded: marks,
          maxMarks: 10,
          allPassed: passedCount === totalCases,
          results,
        },
        null,
        2
      )
    );
  } else {
    console.log(
      `\n[VERDICT]: ${passedCount}/${totalCases} Test Cases Passed. Marks Awarded: ${marks} / 10\n`
    );
  }

  process.exit(passedCount === totalCases ? 0 : 1);
}

main().catch((err) => {
  console.error('[FATAL]: Test runner execution failed:', err.message);
  process.exit(1);
});
